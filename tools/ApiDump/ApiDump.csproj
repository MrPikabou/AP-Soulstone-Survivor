<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>ApiDump</AssemblyName>
    <RootNamespace>ApiDump</RootNamespace>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)../.tools/nuget</RestorePackagesPath>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Mono.Cecil ships with the game's BepInEx install. Set SOULSTONE_DIR or
         pass -p:GameDir=... to point at it. -->
    <GameDir Condition="'$(SOULSTONE_DIR)' != ''">$(SOULSTONE_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Soulstone Survivors</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Mono.Cecil">
      <HintPath>$(GameDir)\BepInEx\core\Mono.Cecil.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
